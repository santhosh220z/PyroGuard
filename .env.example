# PyroGuard Environment Variables
# Never commit .env to version control

# Database
DATABASE_URL=sqlite:///data/incidents/incidents.db

# Alert - SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Alert - Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert - Webhook
WEBHOOK_URL=

# Alert - Resend (email via Resend API)
RESEND_API_KEY=
RESEND_FROM=
ALERT_RESEND_ENABLED=false
ALERT_RESEND_TO=

# Runtime
CAMERA_SOURCE=0
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DRY_RUN=true
LOG_LEVEL=INFO